{
  "name": "@gigaloom/web",
  "version": "0.8.0",
  "description": "Verified static Web operator assets for GigaLoom",
  "license": "MIT",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krakenalt/gigaloom.git",
    "directory": "web"
  },
  "homepage": "https://github.com/krakenalt/gigaloom#readme",
  "bugs": {
    "url": "https://github.com/krakenalt/gigaloom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "node scripts/produce-assets.mjs",
    "build:release": "node scripts/produce-assets.mjs --require-clean",
    "build:bundle": "vite build",
    "build:npm": "node scripts/prepare-package.mjs",
    "build:npm:release": "node scripts/prepare-package.mjs --require-clean",
    "build:package": "node scripts/package-assets.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:package && npm run check:determinism",
    "check:determinism": "node scripts/check-determinism.mjs",
    "generate:brand": "node branding/generate-assets.mjs --frontend-only",
    "lint": "eslint .",
    "pack:verify": "node scripts/verify-package.mjs",
    "test:e2e": "playwright test",
    "test:package": "node --test scripts/package-contract.unit.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "katex": "0.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
