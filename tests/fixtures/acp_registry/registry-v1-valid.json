{
  "version": "1.0.0",
  "agents": [
    {
      "id": "binary-verified",
      "name": "Verified Binary Agent",
      "version": "1.0.0",
      "description": "Checksum-bearing binary fixture",
      "repository": "https://github.com/example/binary-verified",
      "website": "https://example.com/binary-verified",
      "authors": ["Example Maintainers"],
      "license": "Apache-2.0",
      "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/binary-verified.svg",
      "distribution": {
        "binary": {
          "darwin-aarch64": {
            "archive": "https://downloads.example.com/binary-verified-1.0.0-darwin-aarch64.tar.gz",
            "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "cmd": "./bin/binary-verified",
            "args": ["--acp"],
            "env": {"NO_COLOR": "1"}
          }
        }
      }
    },
    {
      "id": "binary-unverified",
      "name": "Unverified Binary Agent",
      "version": "1.1.0",
      "description": "Binary fixture without an upstream checksum",
      "license": "MIT",
      "distribution": {
        "binary": {
          "linux-x86_64": {
            "archive": "https://downloads.example.com/binary-unverified-1.1.0-linux-x86_64.zip",
            "cmd": "binary-unverified",
            "args": ["acp"]
          }
        }
      }
    },
    {
      "id": "npx-exact",
      "name": "Exact Npx Agent",
      "version": "1.2.3",
      "description": "Exact npm package fixture",
      "authors": ["Npx Maintainers"],
      "license": "Apache-2.0",
      "distribution": {
        "npx": {
          "package": "@example/npx-agent@1.2.3",
          "args": ["--acp"],
          "env": {"ACP_MODE": "stdio"}
        }
      }
    },
    {
      "id": "uvx-exact",
      "name": "Exact Uvx Agent",
      "version": "2.3.4",
      "description": "Exact Python package fixture",
      "license": "BSD-3-Clause",
      "distribution": {
        "uvx": {
          "package": "uvx-agent==2.3.4",
          "args": ["--mode", "acp"]
        }
      }
    },
    {
      "id": "multi-distribution",
      "name": "Multiple Distribution Agent",
      "version": "3.0.0",
      "description": "Agent with binary and npm alternatives",
      "license": "proprietary",
      "distribution": {
        "binary": {
          "windows-x86_64": {
            "archive": "https://downloads.example.com/multi-distribution-3.0.0-windows-x86_64.zip",
            "sha256": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
            "cmd": "multi-distribution.exe"
          }
        },
        "npx": {
          "package": "multi-distribution@3.0.0",
          "args": ["--acp"]
        }
      }
    },
    {
      "id": "platform-miss",
      "name": "Unsupported Platform Fixture",
      "version": "4.0.0",
      "description": "Binary fixture without the current test platform",
      "license": "MIT",
      "distribution": {
        "binary": {
          "windows-aarch64": {
            "archive": "https://downloads.example.com/platform-miss-4.0.0-windows-aarch64.tgz",
            "sha256": "1111111111111111111111111111111111111111111111111111111111111111",
            "cmd": "platform-miss.exe"
          }
        }
      }
    }
  ]
}
